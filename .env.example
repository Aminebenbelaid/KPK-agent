# LLM (for future use)
LLM_PROVIDER=kisski
KISSKI_API_KEY=your-kisski-key-here
KISSKI_BASE_URL=https://chat-ai.academiccloud.de/v1
LLM_MODEL=mistral-large-3-675b-instruct-2512

# Database
TRACKER_DB_PATH=data/tracker.db

# Profile
USER_PROFILE_PATH=data/user_profile.yaml

# Internal API auth
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Server
HOST=0.0.0.0
PORT=8000

# Owner/admin access for the multi-user deployment
ADMIN_KEY=pick-a-strong-admin-key
